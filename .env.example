# Créez un nouveau jeton via BotFather. N'utilisez jamais l'ancien jeton publié.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PAPER_CAPITAL_EUR=1000
ROUND_TRIP_FEES_EUR=2

# Chemins à placer sur un disque persistant dans Render.
STATE_PATH=/data/trading_state.json
JOURNAL_PATH=/data/trades.csv

# Paramètres optionnels de gestion de position.
BASE_TP_PCT=1.0
EXTENDED_TP_PCT=2.0
MIN_SL_PCT=0.60
MAX_SL_PCT=1.20
ATR_SL_MULTIPLIER=0.65
BREAKEVEN_TRIGGER_PCT=0.65
TRAILING_DISTANCE_PCT=0.45
